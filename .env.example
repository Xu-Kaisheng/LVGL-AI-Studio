# 本地配置模板（不提交真实值）
# 复制为 .env.local 后填入，重启 npm run dev 生效。
# .env.local 已被 .gitignore 的 *.local 忽略，不会进仓库。

# --- AI 供应商（留空则使用工具内置默认值）---
VITE_AI_PROVIDER=
VITE_AI_API_KEY=
VITE_AI_BASE_URL=
VITE_AI_MODEL=
VITE_AI_THINKING=
VITE_AI_MAX_TOKENS=

# --- 默认画布 / 工程（留空则使用工具内置默认值）---
VITE_DEFAULT_PROJECT_NAME=
VITE_DEFAULT_WIDTH=
VITE_DEFAULT_HEIGHT=
VITE_DEFAULT_THEME=
VITE_DEFAULT_TARGET_DEVICE=
VITE_DEFAULT_BACKGROUND=
